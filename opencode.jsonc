{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "everything": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-everything"],
      "enabled": true
    },
    "github": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-github"],
      "enabled": true
    },
    "figma": {
      "type": "local",
      "command": ["npx", "-y", "@hapins/figma-mcp", "--config=C:\\Users\\USER\\figma-mcp-config.json"],
      "enabled": true
    }
  }
}
